<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Prismatoid" Version="0.4.0" />
    <PackageReference Include="TDLib" Version="1.8.69" />
    <PackageReference Include="tdlib.native" Version="1.8.69" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeleAccess.Core\TeleAccess.Core.csproj" />
  </ItemGroup>

</Project>
