<Window x:Class="TeleAccess.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TeleAccess.App.Localization"
        Title="{x:Static loc:Strings.Settings_Title}"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="{x:Static loc:Strings.Settings_Language}" Target="{Binding ElementName=LanguageBox}" />
        <ComboBox Grid.Row="1" x:Name="LanguageBox" AutomationProperties.Name="{x:Static loc:Strings.Settings_Language}" Margin="0,0,0,8" />

        <StackPanel Grid.Row="2">
            <Label Content="{x:Static loc:Strings.Settings_ApiId}" Target="{Binding ElementName=ApiIdBox}" />
            <TextBox x:Name="ApiIdBox" AutomationProperties.Name="{x:Static loc:Strings.Settings_ApiId}" Margin="0,0,0,8" />

            <Label Content="{x:Static loc:Strings.Settings_ApiHash}" Target="{Binding ElementName=ApiHashBox}" />
            <TextBox x:Name="ApiHashBox" AutomationProperties.Name="{x:Static loc:Strings.Settings_ApiHash}" Margin="0,0,0,8" />

            <Label Content="{x:Static loc:Strings.Settings_Phone}" Target="{Binding ElementName=PhoneBox}" />
            <TextBox x:Name="PhoneBox" AutomationProperties.Name="{x:Static loc:Strings.Settings_Phone}" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="{x:Static loc:Strings.Main_Status}"
                   AutomationProperties.LiveSetting="Assertive" />

        <TextBlock Grid.Row="4" Text="{x:Static loc:Strings.Settings_RestartNeeded}" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Settings_Save}" IsDefault="True" MinWidth="120" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button Content="{x:Static loc:Strings.Settings_LogOut}" MinWidth="120" Margin="0,0,8,0" Click="OnSignOutClick" />
            <Button Content="{x:Static loc:Strings.Prompt_Cancel}" IsCancel="True" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
