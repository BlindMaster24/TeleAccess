<Window x:Class="TeleAccess.App.Windows.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TeleAccess.App.Localization"
        Title="{x:Static loc:Strings.Schedule_Title}"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Schedule_Presets}" Margin="0,0,0,6" />
        <ListBox Grid.Row="1" x:Name="PresetList" Height="120"
                 AutomationProperties.Name="{x:Static loc:Strings.Schedule_Presets}"
                 KeyDown="OnPresetKeyDown" MouseDoubleClick="OnPresetDoubleClick" />

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{x:Static loc:Strings.Schedule_ManualHint}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBox x:Name="ManualBox" AutomationProperties.Name="{x:Static loc:Strings.Schedule_Manual}" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Label Content="{x:Static loc:Strings.Schedule_Date}" Target="{Binding ElementName=DateBox}" />
                    <DatePicker x:Name="DateBox" AutomationProperties.Name="{x:Static loc:Strings.Schedule_Date}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Label Content="{x:Static loc:Strings.Schedule_Time}" Target="{Binding ElementName=TimeBox}" />
                    <TextBox x:Name="TimeBox" AutomationProperties.Name="{x:Static loc:Strings.Schedule_Time}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="{x:Static loc:Strings.Main_Status}"
                   AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Schedule_Send}" IsDefault="True" MinWidth="120" Margin="0,0,8,0" Click="OnSendClick" />
            <Button Content="{x:Static loc:Strings.Prompt_Cancel}" IsCancel="True" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
