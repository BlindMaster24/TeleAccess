<Window x:Class="TeleAccess.App.Windows.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TeleAccess.App.Localization"
        Title="{x:Static loc:Strings.Schedule_Title}"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="{x:Static loc:Strings.Schedule_PickDate}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{x:Static loc:Strings.Schedule_Year}" Target="{Binding ElementName=YearBox}" />
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="YearBox" Margin="0,0,8,0"
                          AutomationProperties.Name="{x:Static loc:Strings.Schedule_Year}"
                          SelectionChanged="OnDatePartChanged" />

                <Label Grid.Row="0" Grid.Column="1" Content="{x:Static loc:Strings.Schedule_Month}" Target="{Binding ElementName=MonthBox}" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MonthBox" Margin="0,0,8,0"
                          AutomationProperties.Name="{x:Static loc:Strings.Schedule_Month}"
                          SelectionChanged="OnDatePartChanged" />

                <Label Grid.Row="0" Grid.Column="2" Content="{x:Static loc:Strings.Schedule_Day}" Target="{Binding ElementName=DayBox}" />
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="DayBox" Width="70" Margin="0,0,8,0"
                          AutomationProperties.Name="{x:Static loc:Strings.Schedule_Day}"
                          SelectionChanged="OnDatePartChanged" />

                <Label Grid.Row="0" Grid.Column="3" Content="{x:Static loc:Strings.Schedule_Hour}" Target="{Binding ElementName=HourBox}" />
                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="HourBox" Width="70" Margin="0,0,8,0"
                          AutomationProperties.Name="{x:Static loc:Strings.Schedule_Hour}" />

                <Label Grid.Row="0" Grid.Column="4" Content="{x:Static loc:Strings.Schedule_Minute}" Target="{Binding ElementName=MinuteBox}" />
                <ComboBox Grid.Row="1" Grid.Column="4" x:Name="MinuteBox" Width="70"
                          AutomationProperties.Name="{x:Static loc:Strings.Schedule_Minute}" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{x:Static loc:Strings.Schedule_ManualHint}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBox x:Name="ManualBox" AutomationProperties.Name="{x:Static loc:Strings.Schedule_Manual}" />
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="{x:Static loc:Strings.Main_Status}"
                   AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Schedule_Send}" IsDefault="True" MinWidth="120" Margin="0,0,8,0" Click="OnSendClick" />
            <Button Content="{x:Static loc:Strings.Prompt_Cancel}" IsCancel="True" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
