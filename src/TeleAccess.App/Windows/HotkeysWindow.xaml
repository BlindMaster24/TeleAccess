<Window x:Class="TeleAccess.App.Windows.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TeleAccess.App.Localization"
        Title="{x:Static loc:Strings.Hotkeys_Title}"
        Width="760" Height="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Hotkeys_Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <ListBox Grid.Row="1" x:Name="CommandList"
                 AutomationProperties.Name="{x:Static loc:Strings.Hotkeys_Title}"
                 KeyDown="OnListKeyDown"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="690">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding HotkeyText}" FontFamily="Consolas" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,12,0,0"
                   AutomationProperties.Name="{x:Static loc:Strings.Main_Status}"
                   AutomationProperties.LiveSetting="Assertive"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
