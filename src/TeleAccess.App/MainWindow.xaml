<Window x:Class="TeleAccess.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TeleAccess.App.Localization"
        Title="{x:Static loc:Strings.AppTitle}"
        Height="760" Width="1120"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="LoginPanel" Grid.Row="0" Margin="24" MaxWidth="560" VerticalAlignment="Center">
            <TextBlock Text="{x:Static loc:Strings.Login_Title}" FontSize="22" Margin="0,0,0,12" />
            <TextBlock x:Name="LoginHint" TextWrapping="Wrap" Margin="0,0,0,12"
                       AutomationProperties.Name="{x:Static loc:Strings.Main_Status}"
                       AutomationProperties.LiveSetting="Assertive" />

            <Label Content="{x:Static loc:Strings.Login_ApiId}" Target="{Binding ElementName=ApiIdBox}" />
            <TextBox x:Name="ApiIdBox" AutomationProperties.Name="{x:Static loc:Strings.Login_ApiId}" Margin="0,0,0,8" />

            <Label Content="{x:Static loc:Strings.Login_ApiHash}" Target="{Binding ElementName=ApiHashBox}" />
            <TextBox x:Name="ApiHashBox" AutomationProperties.Name="{x:Static loc:Strings.Login_ApiHash}" Margin="0,0,0,8" />

            <Label Content="{x:Static loc:Strings.Login_Phone}" Target="{Binding ElementName=PhoneBox}" />
            <TextBox x:Name="PhoneBox" AutomationProperties.Name="{x:Static loc:Strings.Login_Phone}" Margin="0,0,0,8" />

            <Label Content="{x:Static loc:Strings.Login_Code}" Target="{Binding ElementName=CodeBox}" />
            <TextBox x:Name="CodeBox" AutomationProperties.Name="{x:Static loc:Strings.Login_Code}" Margin="0,0,0,8" />

            <Label Content="{x:Static loc:Strings.Login_Password}" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{x:Static loc:Strings.Login_Password}" Margin="0,0,0,8" />

            <Button x:Name="ContinueButton" Content="{x:Static loc:Strings.Login_Continue}"
                    IsDefault="True" MinWidth="160" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Click="OnContinueClick" />
        </StackPanel>

        <Grid x:Name="MainPanel" Grid.Row="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                         AutomationProperties.Name="{x:Static loc:Strings.Main_Search}"
                         TextChanged="OnSearchTextChanged" />
                <ListBox x:Name="ChatList" DisplayMemberPath="Display"
                         AutomationProperties.Name="{x:Static loc:Strings.Main_Chats}"
                         SelectionChanged="OnChatSelected" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2" Margin="8">
                <TextBox x:Name="Composer" DockPanel.Dock="Bottom" Height="96"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{x:Static loc:Strings.Main_Composer}" />
                <ListBox x:Name="MessageList" DisplayMemberPath="Display"
                         AutomationProperties.Name="{x:Static loc:Strings.Main_Messages}"
                         SelectionChanged="OnMessageSelected"
                         KeyDown="OnMessageListKeyDown" />
            </DockPanel>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="1" Margin="8,4"
                   AutomationProperties.Name="{x:Static loc:Strings.Main_Status}"
                   AutomationProperties.LiveSetting="Assertive"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
